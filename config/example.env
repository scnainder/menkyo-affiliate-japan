# Menkyo Affiliate Japan - Environment Configuration
# Copy this file to .env and update with your actual values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menkyo_affiliate
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# API Keys & Secrets
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Payment Processing
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
PAYMENT_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Service
MAIL_SERVICE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@menkyo-affiliate.jp

# AWS (for file storage, optional)
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=menkyo-affiliate-storage

# Google Services (for SEO, Analytics)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
GOOGLE_SEARCH_CONSOLE_TOKEN=your_token

# Session & Security
SESSION_SECRET=your_session_secret_here
COOKIE_DOMAIN=.menkyo-affiliate.jp
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true

# Environment
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Features (Feature Flags)
FEATURE_ANALYTICS=true
FEATURE_PAYMENT=false
FEATURE_AFFILIATE_NETWORK=false

# Affiliate Settings
MIN_PAYOUT_THRESHOLD=10000
PAYOUT_FREQUENCY=monthly
COMMISSION_RATE_DEFAULT=0.07

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15

# Internationalization
DEFAULT_LANGUAGE=ja
SUPPORTED_LANGUAGES=ja,en
TIMEZONE=Asia/Tokyo
